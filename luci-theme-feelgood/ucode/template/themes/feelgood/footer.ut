	{% if (!blank_page): %}
				</div>
			</div>
		</div>
		<footer class="mobile-hide">
			<a href="https://github.com/openwrt/luci" target="_blank" rel="noreferrer">Powered by {{ version.luciname }} ({{ version.luciversion }})</a> /
			{{ entityencode(version.distname ?? '') }} {{ entityencode(version.distversion ?? '') }} ({{ entityencode(version.distrevision ?? '') }})
			{% if (lua_active): %}
				/ {{ _('Lua compatibility mode active') }}
			{% endif %}
			<ul class="breadcrumb pull-right" id="modemenu" style="display:none"></ul>
		</footer>

		<script>L.require('menu-feelgood')</script>
	{% endif %}
</body>
</html>
